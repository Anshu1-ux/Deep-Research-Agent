# LLM_PROVIDER=ollama -> free, local, no key needed
# LLM_PROVIDER=openai -> requires OPENAI_API_KEY
LLM_PROVIDER=ollama
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Free tier at https://tavily.com -- required for web search
TAVILY_API_KEY=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

# Matches docker-compose.yml defaults -- only change if you're pointing at
# a different Postgres instance
POSTGRES_URI=postgresql://research_agent:research_agent@localhost:5442/research_agent
